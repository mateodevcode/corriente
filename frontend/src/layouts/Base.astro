---
// === Layout base del periódico Corriente ===
// Estructura visual extraída del prototipo "corriente diseño/app/page.tsx":
// header con fecha + logo serif + Suscríbete, nav de secciones, footer hairline.

import "../styles/global.css";

const {
  titulo = "Corriente — Periódico digital",
  descripcion = "Corriente: periodismo sobre política, tecnología y el mundo que viene.",
} = Astro.props;

// Fecha de hoy en español para la cabecera
const hoy = new Date().toLocaleDateString("es-ES", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Secciones del nav: la primera ruta del path activa su enlace
// (ej: /politica/xxx marca "Política"; /ultima-hora marca su botón)
const SECCIONES = [
  ["politica", "Política"],
  ["tecnologia", "Tecnología"],
  ["economia-y-negocios", "Economía y Negocios"],
  ["internacional-mundo", "Internacional"],
  ["deportes", "Deportes"],
  ["cultura-y-entretenimiento", "Cultura"],
  ["ciencia-y-salud", "Ciencia y Salud"],
  ["opinion-editorial", "Opinión"],
  ["sociedad", "Sociedad"],
  ["medio-ambiente", "Medio Ambiente"],
  ["educacion", "Educación"],
];
const rutaActual = Astro.url.pathname.replace(/\/+$/, "") || "/";
const activa = (seccion: string) =>
  rutaActual === `/${seccion}` || rutaActual.startsWith(`/${seccion}/`);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
  </head>
  <body>
    <div class="mx-auto max-w-page px-5 sm:px-8 lg:px-12">
      <!-- Cabecera: fecha / logo / suscripción (estilo del prototipo) -->
      <header class="relative border-b border-border">
        <div class="grid grid-cols-2 items-center gap-4 py-5 md:grid-cols-3">
          <div
            class="hidden text-xs font-semibold uppercase tracking-navbar text-muted-foreground md:block"
          >
            {hoy}
          </div>
          <a
            href="/"
            class="text-left font-serif text-2xl font-bold tracking-[-0.06em] sm:text-3xl md:text-center"
            >LA CORRIENTE</a
          >
          <div class="hidden items-center justify-end md:flex">
            <a
              href="/ultima-hora"
              class={`border px-3 py-2 text-xs font-semibold uppercase tracking-meta transition ${
                activa("ultima-hora")
                  ? "border-foreground bg-foreground text-background"
                  : "border-foreground hover:bg-foreground hover:text-background"
              }`}
            >
              Última hora
            </a>
          </div>
          <!-- Botón hamburguesa (solo móvil) -->
          <div class="flex justify-end md:hidden">
            <label for="menu-movil" class="cursor-pointer border border-foreground px-3 py-2 text-xs font-bold uppercase tracking-meta" aria-label="Abrir menú">
              ☰ Menú
            </label>
          </div>
        </div>
        <!-- Nav de secciones (solo escritorio) -->
        <nav
          class="hidden flex-wrap items-center justify-between gap-4 border-t border-border py-4 md:flex"
          aria-label="Secciones"
        >
          <div class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-medium">
            {
              SECCIONES.map(([slug, nombre]) => (
                <a
                  href={`/${slug}`}
                  aria-current={activa(slug) ? "page" : undefined}
                  class={`transition hover:text-primary ${activa(slug) ? "font-bold text-primary" : "text-muted-foreground"}`}
                >
                  {nombre}
                </a>
              ))
            }
          </div>
          <!-- Búsqueda (island React) -->
          <form
            action="/busqueda"
            method="get"
            class="flex items-center gap-2 border-b border-border pb-1 text-sm text-muted-foreground"
          >
            <span aria-hidden="true">⌕</span>
            <input
              type="search"
              name="q"
              placeholder="Buscar historias"
              class="w-36 bg-transparent outline-none placeholder:text-muted-foreground/70"
            />
          </form>
        </nav>

        <!-- Drawer móvil: checkbox puro, sin JS -->
        <input type="checkbox" id="menu-movil" class="peer hidden" />
        <label for="menu-movil" class="fixed inset-0 z-40 hidden bg-black/50 peer-checked:block md:hidden" aria-label="Cerrar menú"></label>
        <aside class="fixed right-0 top-0 z-50 flex h-full w-72 max-w-[85vw] translate-x-full flex-col gap-2 overflow-y-auto bg-card p-6 transition-transform duration-300 peer-checked:translate-x-0 md:hidden" aria-label="Menú móvil">
          <div class="mb-2 flex items-center justify-between">
            <span class="font-serif text-lg font-bold">LA CORRIENTE</span>
            <label for="menu-movil" class="cursor-pointer border border-border px-2 py-1 text-xs" aria-label="Cerrar menú">✕</label>
          </div>
          <a
            href="/ultima-hora"
            class={`border px-3 py-2 text-center text-xs font-bold uppercase tracking-meta ${
              activa("ultima-hora")
                ? "border-foreground bg-foreground text-background"
                : "border-foreground"
            }`}
          >
            ⚡ Última hora
          </a>
          <form action="/busqueda" method="get" class="mt-2 flex items-center gap-2 border-b border-border pb-1 text-sm text-muted-foreground">
            <span aria-hidden="true">⌕</span>
            <input type="search" name="q" placeholder="Buscar historias" class="w-full bg-transparent outline-none placeholder:text-muted-foreground/70" />
          </form>
          <nav class="mt-2 flex flex-col" aria-label="Secciones móvil">
            {
              SECCIONES.map(([slug, nombre]) => (
                <a
                  href={`/${slug}`}
                  aria-current={activa(slug) ? "page" : undefined}
                  class={`border-b border-border py-3 text-sm transition hover:text-primary ${activa(slug) ? "font-bold text-primary" : ""}`}
                >
                  {nombre}
                </a>
              ))
            }
          </nav>
        </aside>
      </header>

      <!-- Contenido de cada página -->
      <slot />

      <!-- Pie de página (hairline, estilo del prototipo) -->
      <footer
        class="mt-12 flex flex-col gap-5 border-t border-border py-8 text-xs uppercase tracking-meta text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
      >
        <span
          class="font-serif text-lg font-bold tracking-[-0.04em] text-foreground"
          >LA CORRIENTE</span
        >
        <span>Periodismo para el mundo que viene.</span>
        <span>© {new Date().getFullYear()} Seventwo</span>
      </footer>
    </div>
  </body>
</html>
