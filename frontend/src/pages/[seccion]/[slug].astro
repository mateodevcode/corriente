---
// === Página de artículo individual (/{seccion}/{slug}) ===
// URL con la sección del artículo (ej: /politica/titulo-del-articulo).
// SEO prioritario: meta tags dinámicos, Open Graph completo (WhatsApp/redes),
// datos estructurados JSON-LD tipo NewsArticle.

import Base from '../../layouts/Base.astro'
import ComentariosIsland from '../../islands/Comentarios.jsx'
import ReaccionesIsland from '../../islands/Reacciones.jsx'
import { api } from '../../lib/api.js'
import { fechaLarga, tiempoLectura, slugAutor, urlArticulo } from '../../lib/formato.js'
import { bloquesAHtml, tiempoLecturaBloques } from '../../lib/bloques.js'

// SSR: el artículo se consulta a la API en cada request (siempre fresco).
// La sección de la URL debe coincidir con la sección real del artículo:
// si no coincide (ej: /deportes/articulo-de-politica) se trata como no encontrado.
const { seccion, slug } = Astro.params
const articulo = await api.articulo(slug)
const seccionValida = articulo && articulo.categoria?.slug === seccion
const pagina = seccionValida ? articulo : null

// Ruta del artículo (para compartir desde el island Reacciones)
const ruta = urlArticulo(articulo || {})

// URL canónica del artículo (para OG y JSON-LD)
// Astro.site normaliza con slash final: se quita para no duplicar la barra
const site = (Astro.site || 'https://corriente.com').toString().replace(/\/$/, '')
const url = `${site}${ruta}`
const imagen = pagina?.imagen_portada_url || `${site}/placeholder-social.jpg`
---

<Base
  titulo={pagina ? `${pagina.titulo} — Corriente` : 'Artículo no encontrado — Corriente'}
  descripcion={pagina?.resumen || 'Artículo de Corriente'}
>
  {pagina ? (
    <main>
      <!-- SEO: Open Graph completo para previews en WhatsApp/redes -->
      <meta property="og:type" content="article" />
      <meta property="og:site_name" content="Corriente" />
      <meta property="og:title" content={pagina.titulo} />
      <meta property="og:description" content={pagina.resumen || ''} />
      <meta property="og:image" content={imagen} />
      <meta property="og:url" content={url} />
      <meta property="article:published_time" content={pagina.fecha_publicacion} />
      <meta property="article:section" content={pagina.categoria?.nombre} />
      <meta name="twitter:card" content="summary_large_image" />
      <link rel="canonical" href={url} />

      <!-- Datos estructurados JSON-LD NewsArticle -->
      <script
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'NewsArticle',
          headline: pagina.titulo,
          description: pagina.resumen,
          image: [imagen],
          datePublished: pagina.fecha_publicacion,
          dateModified: pagina.fecha_actualizacion,
          mainEntityOfPage: { '@type': 'WebPage', '@id': url },
          author: {
            '@type': 'Person',
            name: pagina.autor?.nombre_publico || 'Redacción Corriente',
          },
          publisher: {
            '@type': 'Organization',
            name: 'Corriente',
            logo: { '@type': 'ImageObject', url: `${site}/favicon.svg` },
          },
          articleSection: pagina.categoria?.nombre,
        })}
      />

      <article class="mx-auto max-w-3xl py-10 lg:py-14">
        <!-- Cabecera del artículo: kicker enlaza a su sección -->
        <a
          href={`/${pagina.categoria?.slug}`}
          class="mb-3 inline-block text-xs font-bold uppercase tracking-kicker text-primary hover:underline"
        >
          {pagina.categoria?.nombre}
        </a>
        <h1 class="font-serif text-4xl font-bold leading-[1.02] tracking-[-0.04em] sm:text-5xl">
          {pagina.titulo}
        </h1>
        {pagina.resumen && (
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{pagina.resumen}</p>
        )}
        <div class="mt-6 flex items-center gap-4 text-xs uppercase tracking-meta text-muted-foreground">
          <a href={`/autor/${slugAutor(pagina.autor?.nombre_publico)}`} class="hover:text-primary">
            Por {pagina.autor?.nombre_publico || 'Redacción'}
          </a>
          <span class="size-1 rounded-full bg-primary"></span>
          <span>{fechaLarga(pagina.fecha_publicacion)}</span>
          <span class="size-1 rounded-full bg-primary"></span>
          <span>{tiempoLecturaBloques(pagina.contenido_bloques, pagina.contenido)} de lectura</span>
        </div>

        <!-- Imagen de portada 16/8 -->
        {pagina.imagen_portada_url && (
          <img
            src={pagina.imagen_portada_url}
            alt={pagina.titulo}
            class="mt-8 aspect-16/8 w-full object-cover"
          />
        )}

        <!-- Contenido: bloques v2 o fallback HTML v1 -->
        {pagina.contenido_bloques?.length ? (
          <div class="prosa-corriente mt-10" set:html={bloquesAHtml(pagina.contenido_bloques)} />
        ) : (
          <div class="prosa-corriente mt-10" set:html={pagina.contenido || '<p>Contenido no disponible.</p>'} />
        )}

        <!-- Reacciones/compartir (island React, client:visible para hidratar al entrar en vista) -->
        <ReaccionesIsland ruta={ruta} titulo={pagina.titulo} client:visible />

        <!-- Hilos de comentarios (island React, client:visible para hidratar al entrar en vista) -->
        <section class="mt-14 border-t border-border pt-10">
          <h2 class="font-serif text-2xl font-bold tracking-[-0.03em]">Comentarios</h2>
          <ComentariosIsland articuloId={pagina.id} client:visible />
        </section>
      </article>
    </main>
  ) : (
    <main class="py-24 text-center">
      <p class="font-serif text-3xl font-bold">Artículo no encontrado</p>
      <p class="mt-3 text-muted-foreground">
        Puede que haya sido movido o que la sección de la URL no coincida con la del artículo.
      </p>
      <a href="/" class="mt-6 inline-block border-b-2 border-primary pb-1 text-sm font-bold uppercase tracking-meta text-primary">
        Volver a la portada →
      </a>
    </main>
  )}
</Base>
